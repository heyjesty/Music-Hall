# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public URL of the frontend (used for CORS and the Spotify OAuth redirect back)
FRONTEND_URL=http://localhost:3000
# Optional comma-separated overrides
# CORS_ALLOWED_ORIGINS=https://music-hall.vercel.app
# CSRF_TRUSTED_ORIGINS=https://music-hall.vercel.app

# Optional: Postgres connection string (defaults to SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional: Redis for multi-process WebSocket broadcasting
# REDIS_URL=redis://localhost:6379/0

# --- Spotify API ---
# Get these from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
# Must exactly match a Redirect URI registered in the Spotify dashboard
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback/
